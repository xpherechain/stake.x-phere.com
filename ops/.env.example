# ── ops 공통 설정 (cp .env.example .env 후 채우기, .env 는 커밋 금지) ──
RPC=https://rpc.ankr.com/xphere_mainnet

# 컨트랙트 주소 (메인넷 배포 후 채움)
DIST=0x0000000000000000000000000000000000000000   # RewardDistributor
VAULT=0x0000000000000000000000000000000000000000  # XPStakingVault
WXP=0x0000000000000000000000000000000000000000    # WXP

# 노드 보상 수령(유니온) 지갑 키 — 수령주소 변경 불가이므로 이 지갑에서 스윕.
COLLECTOR_PK=
# 유니온 노드가 늘면 수령지갑도 는다. 노드 보상 주소는 노드 설정에 박혀 있어
# 바꿀 수 없으므로, 새 노드마다 여기에 키를 추가한다 (_2 … _5).
# 노드를 Distributor 로 직접 지급하도록 설정했다면 추가할 것이 없다 —
# 스윕도 키도 필요 없고, 그쪽이 더 안전하다.
COLLECTOR_PK_2=
GAS_RESERVE_WEI=100000000000000000   # 스윕 후 지갑에 남길 가스 (0.1 XP)
# 1회 스윕 상한(wei, 기본 1,000,000 XP). 노드 보상이라기엔 말이 안 되는
# 금액이면 보내지 않고 알린다. 스윕은 되돌릴 수 없다 — Distributor 에는
# 출금 함수가 없고 들어온 돈은 배분·소각으로 갈린다.
# 수령지갑을 다른 용도로 쓰다가 큰 금액이 스쳐 지나가는 경우를 막는다.
MAX_SWEEP_WEI=
# 부분 스윕: "에폭(1일)당 투입 예산"(wei). Distributor 대기 잔고가 이
# 값에 찰 때까지만 스윕 → 정산이 소진하면 다시 채움 = 정확히 일 1회 예산.
# 캡 2M/35M 비례 = 일 ~1,450 XP. 풀오픈 시 이 줄을 비우면 전액 스윕 전환.
SWEEP_LIMIT_WEI=1450000000000000000000

# 콜드월렛 대피 주소 — 예산 충전 후 남는 보상을 즉시 이 주소로 옮긴다.
# 수령지갑은 노드 수령주소라 키 교체가 불가하므로, 잔고를 낮게 유지하는 것이
# 실질적인 유일한 방어책이다. 비우면 대피하지 않는다(수령지갑에 누적).
COLD_ADDR=
# 대피 최소 금액(wei). 이보다 적으면 가스 낭비이므로 건너뛴다. 기본 1,000 XP.
MIN_EVACUATE_WEI=

# settle() 호출 키 — 권한 불필요(permissionless), 가스만 있으면 됨. 저잔고 전용 EOA 권장.
SETTLE_PK=

# 정산 앵커 시각(UTC 시, 0~23) — 특정 시각에 맞추고 싶을 때만 사용.
# ⚠️ 권장: 비워 둘 것. 앵커를 걸면 에폭(24h)이 열리는 시각과 어긋나
# 정산 간격이 24h 를 벗어나고, currentAPR() 이 간격으로 연율화하므로
# 표시 APR 이 왜곡된다(예: 간격 45h → APR 반토막). 비워 두면 에폭이
# 열리는 즉시 정산되어 간격이 24h 로 고정되고 APR 이 안정된다.
SETTLE_HOUR_UTC=

# 모니터링·정산 알림 (선택) — 설정된 채널 모두로 발송
# Slack: 워크스페이스 앱 → Incoming Webhooks 활성화 → 채널 지정 → URL 붙여넣기
SLACK_WEBHOOK=
# Telegram 봇 (선택)
TG_TOKEN=
TG_CHAT=
# 수령지갑 잔고 경고 임계 (wei, 기본 100,000 XP)
COLLECTOR_ALERT_WEI=

# ── 알림 (선택) ───────────────────────────────────────────────
# 노드 보상 유입의 "정상 하한"(wei). 직전 요약 이후 누적이 이보다
# 적으면 일일 요약의 유입 줄에 ⚠ 표시가 붙는다. 기본 1,000 XP.
# (예전엔 이 값 미만이면 보고 자체를 생략했는데, 유입이 멈춘 날이야말로
#  보여야 할 신호라 숨기지 않고 표시만 한다.)
# 개별 유입은 알리지 않는다: 순번마다 589 XP씩 들어와 하루 백 건이 넘는다.
DEPOSIT_ALERT_WEI=
