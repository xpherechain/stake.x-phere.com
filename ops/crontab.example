# crontab -e (전용 유저로) 에 붙여넣기.
# foundry(cast) PATH 필요 → SHELL/PATH 명시. (유저 홈이 /home/xpops 가정)
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin:/home/xpops/.foundry/bin

# 10분마다 — 스윕 + 정산.
#   정산은 에폭(24h)이 열린 직후에만 성공하고 나머지 실행은 즉시 skip이므로
#   부하는 무시할 수준(읽기 1~2회). 촘촘히 도는 이유는 APR 안정성 때문:
#   currentAPR() 이 "마지막 정산 간격"으로 연율화하므로, 간격이 24h 에서
#   벗어날수록 표시 APR 이 왜곡된다. 10분 주기면 간격 오차가 ≤10분(0.7%)로
#   억제된다. (2시간 주기 + 시각 앵커 조합은 간격이 26h/48h 로 튀어 APR 이
#   반토막 나므로 사용하지 않는다 — SETTLE_HOUR_UTC 는 비워 둘 것)
*/10 * * * *  /opt/xp-vault/ops/daily-settle.sh >> /var/log/xp-vault/settle.log 2>&1

# 30분마다 — 상태 점검 + 알림
*/30 * * * *  /opt/xp-vault/ops/monitor.sh      >> /var/log/xp-vault/monitor.log 2>&1

# 5분마다 — 예치/언스테이크 요청/언스테이크 수령/보상 수령을 건별로 슬랙에 알린다.
#   읽기 전용이고 개인키를 쓰지 않아 정산과 완전히 분리돼 있다.
#   (예치왕 이벤트용 report/snapshot 잡은 이벤트 종료와 함께 제거했다.)
*/5 * * * *   /opt/xp-vault/ops/vault-activity.sh    >> /var/log/xp-vault/activity.log 2>&1
